@model List<Reporte>
@{
    ViewData["Title"] = "Listado de Reportes";
}

<h2>@ViewData["Title"]</h2>
<p>Esta es una página protegida. Solo puedes ver esto si estás logueado.</p>

<table class="table table-striped">
         <thead>
             <tr>
                 <th>ID</th>
                 <th>Fecha</th>
                 <th>Ubicación</th>
                 <th>Denunciante</th>
                 <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Id</td>
                    <td>@r.FechaReporte.ToShortDateString()</td>
                   <td>@r.Ubicacion</td>
                   <td>@(r.UsuarioReportante?.NombreCompleto ??
      "N/A")</td>
                    <td>
                        <a asp-controller="Reportes" asp-action="Detalle" asp-route-id="@r.Id" class="btn btn-info btn-sm text-white">
                            <i class="bi bi-eye"></i> Ver Detalle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver</a>
