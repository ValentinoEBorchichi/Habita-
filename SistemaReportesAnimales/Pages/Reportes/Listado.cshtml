@page
@model SistemaReportesAnimales.Pages.Reportes.ListadoModel
@{
    ViewData["Title"] = "Listado de Reportes";
}

<h2>@ViewData["Title"]</h2>
<p>Esta es una página protegida. Solo puedes ver esto si estás logueado.</p>

<table class="table table-striped">
         <thead>
             <tr>
                 <th>ID</th>
                 <th>Fecha</th>
                 <th>Ubicación</th>
                 <th>Denunciante</th>
                 <th>Autoridad</th>
                 <th>Animales</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Reportes)
            {
                <tr>
                    <td>@r.Id</td>
                    <td>@r.FechaReporte.ToShortDateString()</td>
                   <td>@r.Ubicacion</td>
                   <td>@(r.UsuarioReportante?.NombreCompleto ??
      "N/A")</td>
                    <td>@(r.AutoridadAsignada?.Nombre ?? "Sin asignar")</td>
                    <td>
                        @if (r.AnimalesSueltos != null &&
      r.AnimalesSueltos.Any())
                        {
                            <ul>
                                @foreach (var animal in r.AnimalesSueltos)
                                {
                                    <li><strong>@animal.Especie:</strong>
      @animal.Descripcion</li>
                                }
                            </ul>
                        }
                       else
                        {
                           <span>Sin datos</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

<a asp-page="/Index" class="btn btn-secondary">Volver</a>
